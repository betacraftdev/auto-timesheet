{
  "manifest_version": 3,
  "name": "Auto Timesheet",
  "version": "1.0.0",
  "description": "Automatically logs daily computer work hours upon browser startup, tracks worked time, and syncs monthly CSV timesheets.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Auto Timesheet",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "storage",
    "alarms"
  ]
}
